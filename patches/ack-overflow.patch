+// An ACK carries its msg count in a 16-bit field (ISMPacketHeader::Size), and
+// nextPMToACK() truncates a larger count to it. A batch of exactly 65536 msgs
+// then counts as 0, and the loops in sendAcks() that subtract it never finish.
+// Handing nextPMToACK() at most 65535 msgs per call splits a larger batch into
+// several ACKs; PrimProc adds their counts up (BPPSendThread::sendMore()).
+uint32_t ackChunk(uint32_t msgCount)
+{
+  const uint32_t maxAckCount = std::numeric_limits<uint16_t>::max();
+
+  if (msgCount <= maxAckCount)
+    return msgCount;
+
+  cerr << "DEC::sendAcks(): splitting " << msgCount << " msgs into parts of at most " << maxAckCount
+       << endl;
+  return maxAckCount;
+}
